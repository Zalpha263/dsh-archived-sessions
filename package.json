{
  "name": "dsh-archived-sessions",
  "version": "1.6.1",
  "description": "归档会话管理：在设置页查看、恢复、彻底删除、批量删除已归档的会话，并扫描清理无归属的孤儿会话（dsh-archived-sessions）。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./plan": "./lib/plan.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/plan.test.mjs && node test/host.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "archived-sessions",
    "plugin"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "test",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ]
}
